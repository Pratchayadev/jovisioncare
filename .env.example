# ===== ตอนพัฒนาบนเครื่อง =====
# ฐานข้อมูล: เว้นว่างไว้ = ใช้ไฟล์ SQLite ที่ data/jovisioncare.db
# DATABASE_URL="file:./data/jovisioncare.db"

# บัญชีหลังบ้าน /admin
ADMIN_USERNAME="admin"
# สร้างค่าด้วย: npm run hash-password -- "รหัสผ่านของคุณ"
ADMIN_PASSWORD_HASH=""
# สุ่มสตริงยาว ๆ: openssl rand -hex 32
SESSION_SECRET=""

# ===== บน Vercel (ตั้งใน Project Settings → Environment Variables) =====
# Turso — ถ้าติดตั้งผ่าน Vercel Marketplace จะได้ 2 ตัวนี้มาให้อัตโนมัติ
# TURSO_DATABASE_URL="libsql://jovisioncare-xxxx.turso.io"
# TURSO_AUTH_TOKEN=""

# โดเมนจริง (ไม่ตั้ง = ใช้โดเมน .vercel.app ของโปรเจกต์)
# SITE_URL="https://jovisioncare.com"

# Cloudflare R2 สำหรับรูปที่อัปโหลด (จำเป็นบน Vercel — ตอนพัฒนาเว้นว่างได้ รูปจะเก็บที่ data/uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
