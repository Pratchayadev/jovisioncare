{
  "name": "jovisioncare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "tsx --env-file=.env src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "setup": "mkdir -p data && tsx --env-file=.env src/db/migrate.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "vercel-build": "tsx src/db/migrate.ts && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.5",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
